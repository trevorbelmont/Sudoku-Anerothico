// POLÍTICA DE COMENTÁRIOS (clean-code):
// Comentários ficam SEMPRE na linha acima do código que descrevem.
// Nunca misture comentário e código na mesma linha.
// Isso permite apagar um bloco de comentário selecionando a(s) linha(s) inteira(s) sem tocar no código.
//
// IMPORTANTE — VALIDATE NA RAIZ DE $room_id:
// O Firebase avalia o .validate do nó pai em TODA escrita em qualquer subnó filho.
// Portanto, um .validate em "$room_id" com hasChildren([...]) seria violado toda vez que
// o cliente escreve isoladamente em rooms/$roomId/boardState, rooms/$roomId/presence, etc.
// (via fb.update multi-path em publishRoomBoardCell, registerRoomPresence, entre outros).
// A validação estrutural mínima de cada subnó já existe nos próprios nós filhos.
// NÃO adicione .validate de estrutura na raiz de $room_id.
{
  "rules": {
    // Bloqueio padrão na raiz.
    // Nenhuma operação permitida a menos que uma regra mais específica abaixo a autorize.
    ".read": false,
    ".write": false,

    // ─────────────────────────────────────────────────────────────────
    // /rooms — salas de jogo multiplayer
    // ─────────────────────────────────────────────────────────────────
    "rooms": {
      // Leitura livre: qualquer cliente pode ler qualquer sala
      // para entrar, observar ou validar o estado do tabuleiro.
      ".read": true,

      "$room_id": {
        // Escrita aberta por sala: o jogo não usa autenticação Firebase.
        // A proteção lógica (sala ativa, sala protegida por N dias) é feita
        // no cliente via checkRoomStatus() antes de qualquer escrita.
        ".write": true,

        // ── updatedAt: watermark do cold storage (raiz, número epoch ms) ──
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },

        // ── boardState: estado atual do tabuleiro ──────────────────────
        "boardState": {
          ".validate": "newData.hasChildren(['boardInstanceNumber', 'boardValues', 'updatedAtTimestamp'])",

          "boardInstanceNumber": {
            ".validate": "newData.isNumber()"
          },
          "elapsedSeconds": {
            ".validate": "newData.isNumber()"
          },
          "isCompleted": {
            ".validate": "newData.isBoolean()"
          },
          "gameName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "lastUpdatedByPlayerId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "updatedAtTimestamp": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },

          // boardValues e pencilNotes são arrays aninhados.
          // Não validamos estrutura interna para suportar grids de tamanho variável (4×4 a 25×25).
          "$boardStateOther": {
            ".validate": true
          }
        },

        // ── meta: configuração e identidade da instância do tabuleiro ──
        "meta": {
          ".validate": "newData.hasChildren(['createdAtTimestamp', 'ownerPlayerId', 'instanceNumber', 'boardDimension'])",

          "createdAtTimestamp": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "ownerPlayerId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "instanceNumber": {
            ".validate": "newData.isNumber()"
          },
          "boardDimension": {
            ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 25"
          },
          "gameMode": {
            ".validate": "newData.isString()"
          },
          "difficultyLevel": {
            ".validate": "newData.isString()"
          },
          "roomMode": {
            ".validate": "newData.isString() && (newData.val() === 'coop' || newData.val() === 'versus')"
          },
          "realtimeMetrics": {
            ".validate": "newData.isBoolean()"
          },
          "minimumSymbolValue": {
            ".validate": "newData.isNumber()"
          },
          "maximumSymbolValue": {
            ".validate": "newData.isNumber()"
          },
          "includesZeroValue": {
            ".validate": "newData.isBoolean()"
          },
          "blockRowCount": {
            ".validate": "newData.isNumber()"
          },
          "blockColumnCount": {
            ".validate": "newData.isNumber()"
          },

          // symbolValues, fixedInitialGrid, solutionGrid: arrays — estrutura interna não validada.
          // solutionGrid é omitido pelo frontend; regra permissiva suporta tanto ausência
          // (cliente web) quanto presença (restauração de backup pelo GAS).
          "$metaOther": {
            ".validate": true
          }
        },

        // ── moves: log de jogadas (append via fb.push) ─────────────────
        // executeMultiplayerNewGame() limpa este nó com fb.remove() ao iniciar
        // nova instância — portanto não forçamos append aqui.
        "moves": {
          "$move_id": {
            ".validate": "newData.hasChildren(['userId', 'action'])",

            "userId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "userName": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
            },
            "action": {
              ".validate": "newData.isString()"
            },
            "sequence": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "row": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "column": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "clientTimestamp": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "userColor": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
            },
            "value": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            // timestamp pode ser serverTimestamp (object) ou número — permissivo.
            "$moveOther": {
              ".validate": true
            }
          }
        },

        // ── contributions: mapa célula → autoria ───────────────────────
        "contributions": {
          // Chave no formato "{row}_{col}", ex: "3_7"
          "$cell_key": {
            ".validate": "newData.hasChildren(['kind', 'action', 'playerId'])",

            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'PLAYER' || newData.val() === 'NASA')"
            },
            "action": {
              ".validate": "newData.isString()"
            },
            "playerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "playerName": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
            },
            "playerColor": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
            },
            "timestamp": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        },

        // ── members: histórico de participantes (persistente) ──────────
        "members": {
          "$player_id": {
            ".validate": "newData.hasChildren(['playerId', 'playerName'])",

            "playerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "playerName": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "playerColor": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
            },
            "joinedAtTimestamp": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        },

        // ── players: presença online (removido no onDisconnect) ────────
        "players": {
          "$player_id": {
            ".validate": "newData.hasChildren(['playerId', 'playerName'])",

            "playerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "playerName": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "playerColor": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
            },
            "joinedAtTimestamp": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        },

        // ── cursors: posição atual de cada jogador (mutável, best-effort) ──
        "cursors": {
          "$player_id": {
            "row": {
              ".validate": "newData.isNumber()"
            },
            "column": {
              ".validate": "newData.isNumber()"
            },
            "userId": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
            },
            "userName": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
            },
            "userColor": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
            },
            "timestamp": {
              ".validate": "!newData.exists() || newData.isNumber()"
            }
          }
        },

        // ── presence: marcador de proteção e atividade da sala ─────────
        "presence": {
          "isActive": {
            ".validate": "newData.isBoolean()"
          },
          "lastSeenTimestamp": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "lastDisconnectedTimestamp": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        },

        // ── settings: configurações votadas pela sala ──────────────────
        "settings": {
          "immediateErrorCheck": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "immediateErrorUpdatedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "immediateErrorUpdatedBy": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
          }
        },

        // ── colorAssignments: mapa playerId → cor hex ──────────────────
        "colorAssignments": {
          "$player_id": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },

        // ── proposal: votação de novo tabuleiro (efêmera) ──────────────
        // Removida automaticamente ~900 ms após a conclusão.
        "proposal": {
          "$proposalField": {
            ".validate": true
          }
        },

        // ── featureVote: votação de NASA / erro imediato (efêmera) ─────
        // Removida automaticamente ~1700 ms após a resolução.
        "featureVote": {
          "$featureVoteField": {
            ".validate": true
          }
        },

        // ── privateData: metadados de cliente por jogador ──────────────
        // Contém user-agent, idioma, fuso horário.
        // Leitura pública mantida para que o cold storage capture esses dados.
        // Uma versão futura pode restringir quando autenticação for adicionada.
        "privateData": {
          "$player_id": {
            "clientMetadata": {
              "schemaVersion": {
                ".validate": "!newData.exists() || newData.isNumber()"
              },
              "capturedAtTimestamp": {
                ".validate": "!newData.exists() || newData.isNumber()"
              },
              "language": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)"
              },
              "timeZone": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
              },
              "online": {
                ".validate": "!newData.exists() || newData.isBoolean()"
              },
              "connectionType": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)"
              },
              "$metaField": {
                ".validate": true
              }
            }
          }
        },

        // ── metrics: metadados de sessão legados (schema v1) ───────────
        // Presente em salas antigas antes da migração para privateData.
        // Mantido permissivo para não bloquear leituras de backups históricos.
        "metrics": {
          "$player_id": {
            "$metricField": {
              ".validate": true
            }
          }
        }
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // /chats — mensagens de eventos das salas (reservado para uso futuro)
    // ─────────────────────────────────────────────────────────────────
    "chats": {
      // Leitura livre para que clientes e o job coldstorage_chats (futuro)
      // possam ler o histórico de mensagens.
      ".read": true,

      "$room_id": {
        // Append-only: permite escrita apenas se o nó não existia ou
        // se o novo dado ainda existe (impede delete de mensagens).
        ".write": "!data.exists() || newData.exists()",

        "$message_id": {
          ".validate": "newData.hasChildren(['userId', 'action'])",

          "userId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "action": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "text": {
            // Limite de 250 caracteres para conter spam e proteger cota de largura de banda.
            ".validate": "newData.isString() && newData.val().length <= 250"
          },
          "$msgOther": {
            ".validate": true
          }
        }
      }
    },

    // ─────────────────────────────────────────────────────────────────
    // /server_meta — metadados de execução dos jobs GAS (backend only)
    // ─────────────────────────────────────────────────────────────────
    // Escrito exclusivamente pelo GAS via Firebase Secret (Admin SDK / REST).
    // Bloqueio total para leitura e escrita de clientes web.
    "server_meta": {
      ".read": false,
      ".write": false
    },

    // ─────────────────────────────────────────────────────────────────
    // /server_config — configuração administrativa (backend only)
    // ─────────────────────────────────────────────────────────────────
    // Bloqueio total. Operações permitidas exclusivamente via Firebase Secret.
    "server_config": {
      ".read": false,
      ".write": false
    }
  }
}
